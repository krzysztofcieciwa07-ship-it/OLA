{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ola.example/schemas/dora-control-verdict-v0.1.json",
  "type": "object",
  "required": ["control_id","status","evidence_integrity","approval_status","evidence_ids","binding","reason","reviewer"],
  "properties": {
    "control_id": {"type":"string","pattern":"^DORA-CM-[0-9]{2}$"},
    "status": {"enum":["PASS","FAIL","PARTIAL","BLOCKED","UNKNOWN","SKIPPED","NOT_APPLICABLE"]},
    "evidence_integrity": {"enum":["VERIFIED","INVALID","UNVERIFIED"]},
    "approval_status": {"enum":["APPROVED","PENDING","REJECTED"]},
    "evidence_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "binding": {"type":"object","required":["repository","change_id","commit_sha","artifact_digest"],"properties":{"repository":{"type":"string"},"change_id":{"type":"string"},"commit_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"artifact_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"additionalProperties":false},
    "reason": {"type":"string","minLength":1},
    "reviewer": {"type":"object","required":["identity","role","approved_at"],"properties":{"identity":{"type":"string","minLength":1},"role":{"type":"string","minLength":1},"approved_at":{"type":"string","format":"date-time"}},"additionalProperties":false}
  },
  "additionalProperties": false
}
