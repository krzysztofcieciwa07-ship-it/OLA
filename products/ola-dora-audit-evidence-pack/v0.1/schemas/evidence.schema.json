{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ola.example/schemas/dora-evidence-v0.1.json",
  "type": "object",
  "required": ["schema_version","evidence_id","control_id","evidence_type","tenant_id","source","collector","captured_at","payload","payload_digest","binding"],
  "properties": {
    "schema_version": {"const":"ola.evidence.v0.1"},
    "evidence_id": {"type":"string","minLength":1},
    "control_id": {"type":"string","pattern":"^DORA-CM-[0-9]{2}$"},
    "evidence_type": {"type":"string","minLength":1},
    "tenant_id": {"type":"string","minLength":1},
    "source": {"type":"object","required":["system","record_id","uri"],"properties":{"system":{"type":"string","minLength":1},"record_id":{"type":"string","minLength":1},"uri":{"type":"string","minLength":1}},"additionalProperties":true},
    "collector": {"type":"object","required":["id","version"],"properties":{"id":{"type":"string"},"version":{"type":"string"}},"additionalProperties":true},
    "captured_at": {"type":"string","format":"date-time"},
    "payload": {"type":"object"},
    "payload_digest": {"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},
    "binding": {"$ref":"#/$defs/binding"}
  },
  "$defs": {
    "binding": {"type":"object","required":["repository","change_id","commit_sha","artifact_digest"],"properties":{"repository":{"type":"string","minLength":1},"change_id":{"type":"string","minLength":1},"commit_sha":{"type":"string","pattern":"^[a-f0-9]{40}$"},"artifact_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},"additionalProperties":false}
  },
  "additionalProperties": false
}
