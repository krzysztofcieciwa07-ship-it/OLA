#!/bin/sh
# Install with: git config core.hooksPath .githooks
# Read stdin from Git pre-push. Do not fetch or mutate refs in this hook.
set -eu
remote="${1:-origin}"
case "$remote" in
  *[!a-zA-Z0-9_.-]*|"") echo "BLOCKED: invalid remote name" >&2; exit 1 ;;
esac
base="$(git rev-parse --verify "refs/remotes/$remote/main^{commit}")" || {
  echo "BLOCKED: remote main not available; fetch main before push" >&2; exit 1;
}
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "$local_ref" ] || continue
  case "$local_sha" in
    0000000000000000000000000000000000000000) echo "BLOCKED: deletion requires separate approval" >&2; exit 1 ;;
  esac
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "BLOCKED: direct main push prohibited" >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$base" "$local_sha"; then
    echo "BLOCKED: branch not based on known main" >&2
    exit 1
  fi
  OLA_ALLOWED_SIGNER_FPRS="${OLA_ALLOWED_SIGNER_FPRS:-}" python3 scripts/commit_integrity_guard.py "$base" "$local_sha" || exit 1
done
